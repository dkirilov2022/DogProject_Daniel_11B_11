@using DogsProject_Daniel_11_11.Models.Dog
@model IEnumerable<DogAllViewModel>

@{
    ViewData["Title"] = "All Dogs";
}
<p>
    <a asp-action="Create">Create New Dog</a>
</p>
<form asp-controller="Dog" asp-action="Index" method="get">
    <p>
        Breed: <input type="text" name="SearchStringBreed"/>
        Name: <input type="text" name="SearchStringName"/>
        <input type="submit" value="Filter"/>
    </p>
</form>
<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Breed</th>
        <th>Picture</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>@item.Breed</td>
            <td>
                <img src="@item.DogPicture" alt="Image" width="100" />
            </td>
            <td>
                <a asp-action="Edit" asp-controller="Dog" asp-route-id="@item.Id">Edit</a>
                <a asp-action="Details" asp-controller="Dog" asp-route-id="@item.Id">Details</a>
                <a asp-action="Delete" asp-controller="Dog" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>